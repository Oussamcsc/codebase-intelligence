# ===========================================
# Required API Keys
# ===========================================
# Required for repository analysis and OpenAI review synthesis.
OPENAI_API_KEY=your-openai-api-key-here

# ===========================================
# GitHub OAuth (Optional)
# ===========================================
# Manual public repository URL analysis works without OAuth.
# For OAuth repo browsing, create a GitHub OAuth App with:
# - Homepage URL: http://localhost:3000
# - Authorization callback URL: http://localhost:8000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ===========================================
# Public URLs / Frontend Build
# ===========================================
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
REACT_APP_API_URL=http://localhost:8000

# ===========================================
# API Runtime
# ===========================================
API_HOST=0.0.0.0
API_PORT=8000
DB_PATH=/app/data/code_review_results.db

# ===========================================
# ChromaDB / RAG
# ===========================================
# Docker uses the Chroma sidecar by hostname on the private compose network.
# Host access is exposed as http://localhost:8001 for debugging.
VECTOR_DB_PATH=/app/data/chroma_db
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_SERVER_HOST=0.0.0.0
CHROMA_SERVER_HTTP_PORT=8000
CHROMA_HOST_PORT=8001
ENABLE_RAG=false
EMBEDDING_MODEL=text-embedding-3-small

# ===========================================
# Model / Analysis Settings
# ===========================================
ANALYSIS_MODE=fast
GPT_REVIEW_MODEL=gpt-4o-mini
GPT_TIMEOUT_SECONDS=30
MAX_ANALYSIS_FILES=40
